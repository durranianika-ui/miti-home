# =============================================================================
# Miti Home — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables marked REQUIRED must be set for the store to run.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# REQUIRED. Public origin, no trailing slash. Used for canonical URLs, sitemap,
# emails and payment return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL — Neon in production; any local Postgres in development)
# -----------------------------------------------------------------------------
# REQUIRED. localhost/127.0.0.1 URLs use node-postgres; everything else uses the
# Neon serverless (WebSocket) driver.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mitihome

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# REQUIRED in production. Usually the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# Optional "Continue with Google". Leave both empty to hide it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend) — order confirmations, status updates, password reset, welcome
# -----------------------------------------------------------------------------
# Without an API key, non-critical emails are skipped (logged) and password
# reset shows an error. Verify your sending domain in Resend first.
RESEND_API_KEY=
# REQUIRED in production when RESEND_API_KEY is set, e.g. "Miti Home <orders@mitihome.ae>"
RESEND_FROM_EMAIL=
# Optional reply-to for customer replies, e.g. hello@mitihome.ae
RESEND_REPLY_TO=

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Cash on delivery works without any configuration.
# Card payments use a hosted provider page. Leave the secret key empty to hide
# the card option entirely (the store never shows a method it cannot charge).
PAYMENT_PROVIDER=stripe
# Stripe account registered in the UAE (settles AED). Test keys start sk_test_.
STRIPE_SECRET_KEY=
# From the webhook endpoint https://<domain>/api/webhooks/payments/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# UAE commerce rules (all optional — defaults shown). Confirm before launch.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_AED=300
NEXT_PUBLIC_SHIPPING_FEE_AED=25
NEXT_PUBLIC_COD_ENABLED=true
NEXT_PUBLIC_COD_FEE_AED=10
NEXT_PUBLIC_COD_MAX_ORDER_AED=2500
# Comma-separated emirate names; empty = all seven.
NEXT_PUBLIC_SHIPPING_EMIRATES=
NEXT_PUBLIC_COD_EMIRATES=
NEXT_PUBLIC_DELIVERY_ESTIMATE=1–3 working days across the UAE
NEXT_PUBLIC_VAT_RATE=0.05
NEXT_PUBLIC_PRICES_INCLUDE_VAT=true
NEXT_PUBLIC_RETURN_WINDOW_DAYS=7
NEXT_PUBLIC_EXCHANGE_WINDOW_DAYS=7

# -----------------------------------------------------------------------------
# Brand, contact & legal (optional — unset values are hidden, not faked)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
# E.164, e.g. +9715XXXXXXXX
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only for wa.me links, e.g. 9715XXXXXXXX
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=Dubai, United Arab Emirates
NEXT_PUBLIC_CONTACT_HOURS=Sunday – Friday, 10:00 – 19:00 GST
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_TRADE_LICENCE=
NEXT_PUBLIC_VAT_TRN=
SECURITY_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# -----------------------------------------------------------------------------
# Analytics (all optional; nothing loads when unset or in development)
# -----------------------------------------------------------------------------
# Google Tag Manager container. When set, GA4 should be configured inside GTM.
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID, loaded directly only when no GTM container is set.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Vercel Web Analytics (enable it in the Vercel project too).
NEXT_PUBLIC_VERCEL_ANALYTICS=false
# Set to true to load analytics while running `next dev`.
NEXT_PUBLIC_ANALYTICS_IN_DEV=false

# -----------------------------------------------------------------------------
# Image storage (Cloudinary) — optional; used by the admin image uploader.
# Catalogue images can also be served from /public/products.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Search (optional semantic search). Lexical search works without these.
# -----------------------------------------------------------------------------
# Comma-separated Gemini API keys (rotated) for embeddings.
GEMINI_API_KEYS=
PINECONE_API_KEY=
PINECONE_INDEX=miti-home-products
PINECONE_NAMESPACE=products
PRODUCT_SEARCH_TEXT_MIN_SCORE=
PRODUCT_SEARCH_IMAGE_MIN_SCORE=
# Tuning for "You may also like" when semantic search is enabled.
PRODUCT_RECOMMENDATION_MIN_SCORE=
PRODUCT_RECOMMENDATION_QUERY_TOP_K=

# -----------------------------------------------------------------------------
# AI concierge (optional, OFF by default — Miti Home does not compete on price)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_BARGAIN_AI=false
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Marketing email unsubscribe links are signed with BETTER_AUTH_SECRET.
# -----------------------------------------------------------------------------
